{
  "name": "mintforge-website",
  "private": true,
  "type": "module",
  "scripts": {
    "brand": "cd .. && python3 brand/build_brand.py",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node tests/server.mjs",
    "check": "npm run check:site && npm run check:html",
    "check:site": "node ../tools/check-site.mjs dist",
    "check:html": "html-validate \"dist/**/*.html\"",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "html-validate": "^11.17.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
