# Kopie als .env anlegen und eigene Werte eintragen. .env wird nie committet (siehe .gitignore im Repo-Root).
#
# Gemeinsamer Schlüssel für die Start-Tokens (Server und werkzeuge/token.py), mindestens 32 Zeichen.
# Erzeugen z. B. mit:  python3 -c "import secrets; print(secrets.token_hex(32))"
MINTFORGE_TOKEN_SCHLUESSEL=

# Optional: Bearer-Token, mit dem die Mod Ergebnisse an den Empfänger meldet
MINTFORGE_ERGEBNIS_TOKEN=

# Optional: Host und Port der PWA
MINTFORGE_HOST=localhost
MINTFORGE_WEB_PORT=8443
