    "2": "1rem",
    "3": "1.5rem",
    "4": "2rem",
    "5": "2.5rem",
    "6": "3rem",
    "8": "4rem",
    "10": "5rem"
  },
  "radius": {
    "klein": "3px",
    "mittel": "4px",
    "gross": "6px",
    "rund": "999px"
