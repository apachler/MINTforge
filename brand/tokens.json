    "logo": { "familie": "anzeige", "schnitt": 900, "datei": "website/node_modules/@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff" },
    "groessen": {
      "klein": "0.8125rem",
      "meta": "0.75rem",
      "text": "1rem",
      "gross": "1.125rem",
      "h3": "clamp(1.375rem, 1.1rem + 1vw, 1.625rem)",
