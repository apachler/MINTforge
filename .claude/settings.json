{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/set-git-identity.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm ci:*)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm test:*)",
      "Bash(npx playwright test:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(npm run brand:*)",
      "Bash(npm run check:site:*)",
      "Bash(npm run check:html:*)",
      "Bash(npm run test:a11y:*)",
      "Bash(npm run test:visual:*)",
      "Bash(python3 brand/build_brand.py:*)",
      "Bash(node tools/check-site.mjs:*)",
      "Bash(npx html-validate:*)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.local.yml)",
      "Read(./**/secrets.env)",
      "Read(~/.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)"
    ]
  }
}
